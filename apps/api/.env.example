# apps/api — Environment Variables
# Copy to .env

# Supabase (Project Nobi) — Settings → Database → Connection string → URI
DATABASE_URL="postgresql://postgres.[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?schema=mathquest"

# Auth
JWT_SECRET="generate-a-strong-secret-here"
JWT_EXPIRES_IN="7d"

# Server
PORT=3001
NODE_ENV="development"
FRONTEND_URL="http://localhost:3000"
